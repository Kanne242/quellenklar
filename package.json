{
  "name": "quellenklar",
  "private": true,
  "version": "0.1.0",
  "description": "QuellenKlar \u2013 Dokumente & Belege. Monorepo f\u00fcr Mobile-App, API und Dokumentengine.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:mobile": "pnpm --filter @quellenklar/mobile start",
    "dev:api": "pnpm --filter @quellenklar/api dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
