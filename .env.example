# QuellenKlar – Beispielkonfiguration. KEINE echten Schlüssel in dieses Repository einchecken.
# Kopiere die Datei nach .env (API) bzw. apps/mobile/.env (App) und trage eigene Werte ein.

# ---------------------------------------------------------------- API (services/api)
NODE_ENV=development
PORT=8787
# Supabase-Projekt (Region EU, z. B. Frankfurt eu-central-1)
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Nur serverseitig! Niemals in der App ausliefern. Ab Phase 2 benötigt.
SUPABASE_SERVICE_ROLE_KEY=
# Ab Phase 3 benötigt. Nur serverseitig.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Kommagetrennte Liste erlaubter Web-Ursprünge (für die mobile App nicht nötig)
CORS_ORIGINS=

# ---------------------------------------------------------------- Mobile App (apps/mobile/.env)
# Variablen mit EXPO_PUBLIC_ landen im App-Bundle und sind damit ÖFFENTLICH.
# Hier nur Werte eintragen, die öffentlich sein dürfen (Anon-Key ist durch RLS geschützt).
EXPO_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_API_URL=http://localhost:8787
# Ab Phase 5 (RevenueCat, öffentliche SDK-Schlüssel)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
